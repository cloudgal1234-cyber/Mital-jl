# PostgreSQL connection string. The booking guarantee relies on the
# btree_gist extension + a GiST EXCLUDE constraint, both Postgres-only —
# do not swap this for MySQL/SQLite without re-deriving the locking strategy.
DATABASE_URL="postgresql://user:password@localhost:5432/mital_nails?schema=public"

# Simple shared-secret gate for /admin (see src/middleware.ts).
# Replace with a real auth provider (NextAuth, Clerk, etc.) before production.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
